# Copy this file to .env and fill in your key. Never commit .env.

# LLM provider: groq (default) or gemini
OPSAGENT_PROVIDER=groq
OPSAGENT_MODEL=openai/gpt-oss-120b

# Paste your Groq key here (https://console.groq.com/keys)
GROQ_API_KEY=

# Only needed if OPSAGENT_PROVIDER=gemini (then also set OPSAGENT_MODEL, e.g. gemini-2.5-flash)
GOOGLE_API_KEY=

# Groq free tier allows about 8000 tokens per minute for gpt-oss-120b; the agent paces itself
# to stay under this. Raise it if you upgrade your Groq plan (0 disables pacing).
OPSAGENT_TPM_LIMIT=8000
# low | medium | high (gpt-oss only). "low" keeps hidden reasoning tokens small.
OPSAGENT_REASONING_EFFORT=low

# Safety settings (rupees, decimals allowed)
OPSAGENT_REFUND_APPROVAL_THRESHOLD=5000.00
OPSAGENT_MIN_CONFIDENCE=0.6

# Paths (defaults are fine)
OPSAGENT_DB_PATH=data/opsagent.db
OPSAGENT_CHROMA_DIR=data/chroma
OPSAGENT_CHECKPOINT_PATH=data/checkpoints.db
OPSAGENT_REPORTS_DIR=reports

# Set to 1 to use the real calendar date instead of the fixed demo date (2026-09-27)
OPSAGENT_USE_REAL_DATE=0

# Optional failure injection for demos: tool_timeout | bad_llm_output | db_locked
OPSAGENT_INJECT_FAILURE=

OPSAGENT_LOG_LEVEL=INFO
